{
  "schema": "janus.source_pin.contract.v1",
  "artifact_id": "JANUS-SOURCE-PIN-CONTRACT-v1.0",
  "status": "IMPLEMENTATION_CANDIDATE",
  "coordination_issue": "Hawkar-usls/Janus_Genesis#121",
  "laws": [
    "PIN_STRING_SHAPE_DOES_NOT_IMPLY_PIN_SEMANTICS",
    "GIT_COMMIT_SHA1_REQUIRES_EXPLICIT_KIND_AND_LOWERCASE_40_HEX",
    "OPAQUE_VERSION_TOKEN_CANNOT_SATISFY_EXACT_GIT_REPLAY",
    "PRIVATE_EXACT_PIN_MAY_BE_VERIFIED_LOCALLY_WITHOUT_PUBLICATION",
    "PRIVATE_SOURCE_ID_PUBLIC_PROJECTION_REQUIRES_OPAQUE_NUMERIC_ID",
    "PUBLIC_PROJECTION_OMITS_PRIVATE_PIN_VALUE_AND_LOCAL_PINSET_ID",
    "SOURCE_PIN_CONTRACT_DOES_NOT_GRANT_SOURCE_WRITEBACK",
    "CI_GREEN_DOES_NOT_GRANT_MERGE_PERMISSION"
  ],
  "pin_kinds": {
    "GIT_COMMIT_SHA1": {
      "value_contract": "^[0-9a-f]{40}$",
      "exact_git_replay_eligible": true,
      "type_inference_from_value": false
    },
    "OPAQUE_VERSION_TOKEN": {
      "value_contract": "EXPLICIT_NONEMPTY_SAFE_TOKEN",
      "exact_git_replay_eligible": false,
      "type_inference_from_value": false
    }
  },
  "privacy": {
    "private_source_id_contract": "OPAQUE_NUMERIC_1_TO_32_DIGITS",
    "private_exact_pin_publication_required": false,
    "private_exact_pin_public_projection": "OMIT_VALUE_AND_LOCAL_DIGEST",
    "local_pinset_id_publication_required": false,
    "private_pinset_digest_publication_required": false
  },
  "authority_boundary": {
    "source_writeback": false,
    "source_delete": false,
    "history_rewrite": false,
    "code_execution": false,
    "external_effect_authority": false,
    "authority_delta": 0,
    "mass_effect_budget_delta": 0
  },
  "claim_ceiling": "This contract types source pins and provides a privacy-safe integration boundary between generic SWARM version pins and exact Git-object Nexus replay. It does not acquire repositories, prove private pins publicly, mutate frozen component heads, execute source code, write back to sources, or grant merge/command authority."
}
